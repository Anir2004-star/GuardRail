generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  name            String?
  // Nullable during migration so existing users do not need invented names.
  // Registration will require firstName and lastName; middleName is optional.
  firstName       String?          @map("first_name") @db.VarChar(60)
  middleName      String?          @map("middle_name") @db.VarChar(60)
  lastName        String?          @map("last_name") @db.VarChar(60)
  passwordHash    String?          @map("password_hash") @db.VarChar(60)
  googleSubject   String?          @unique @map("google_subject") @db.VarChar(255)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  emailVerificationExempt Boolean  @default(false) @map("email_verification_exempt")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  devices         Device[]

  @@map("users")
}

model RefreshSession {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  tokenHash         String          @unique @map("token_hash") @db.Char(64)
  familyId          String          @map("family_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedById      String?         @unique @map("replaced_by_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          RefreshSession? @relation("RefreshRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model GoogleChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  secretHash String   @unique @map("secret_hash") @db.Char(64)
  nonceHash  String   @map("nonce_hash") @db.Char(64)
  intent     String   @db.VarChar(10)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("google_challenges")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum DeviceType {
  Laptop
  Smartphone
  Tablet
}

model Device {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  requestId   String     @map("request_id") @db.Uuid
  name        String     @db.VarChar(60)
  type        DeviceType
  brand       String?    @db.VarChar(80)
  model       String?    @db.VarChar(80)
  os          String?    @db.VarChar(80)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pairingSessions DevicePairingSession[]
  credentials DeviceCredential[]
  storageReport DeviceStorageReport?
  folderScan DeviceFolderScan?

  @@unique([userId, requestId])
  @@index([userId, createdAt, id])
  @@map("devices")
}

enum PairingState {
  Waiting
  Claimed
  Approved
  Completed
  Cancelled
  Rejected
}

model DevicePairingSession {
  id String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  codeHash String @unique @map("code_hash") @db.Char(64)
  state PairingState @default(Waiting)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  claimId String? @unique @map("claim_id") @db.Uuid
  claimTokenHash String? @unique @map("claim_token_hash") @db.Char(64)
  comparisonCode String? @map("comparison_code") @db.VarChar(6)
  appName String? @map("app_name") @db.VarChar(80)
  platform String? @db.VarChar(80)
  appVersion String? @map("app_version") @db.VarChar(40)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credential DeviceCredential?

  @@index([deviceId, createdAt])
  @@index([expiresAt])
  @@map("device_pairing_sessions")
}

model DeviceCredential {
  id String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  pairingId String @unique @map("pairing_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pairing DevicePairingSession @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  storageReports DeviceStorageReport[]
  folderScans DeviceFolderScan[]

  @@index([deviceId])
  @@index([expiresAt])
  @@map("device_credentials")
}

model DeviceStorageReport {
  deviceId String @id @map("device_id") @db.Uuid
  credentialId String @map("credential_id") @db.Uuid
  reportId String @map("report_id") @db.Uuid
  collectedAt DateTime @map("collected_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  volumes Json
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credential DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@map("device_storage_reports")
}

model DeviceFolderScan {
  deviceId String @id @map("device_id") @db.Uuid
  credentialId String @map("credential_id") @db.Uuid
  scanId String @map("scan_id") @db.Uuid
  finishedAt DateTime @map("finished_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  report Json
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credential DeviceCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@map("device_folder_scans")
}
