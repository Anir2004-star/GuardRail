generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  name            String?
  // Nullable during migration so existing users do not need invented names.
  // Registration will require firstName and lastName; middleName is optional.
  firstName       String?          @map("first_name") @db.VarChar(60)
  middleName      String?          @map("middle_name") @db.VarChar(60)
  lastName        String?          @map("last_name") @db.VarChar(60)
  passwordHash    String?          @map("password_hash") @db.VarChar(60)
  googleSubject   String?          @unique @map("google_subject") @db.VarChar(255)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  emailVerificationExempt Boolean  @default(false) @map("email_verification_exempt")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model RefreshSession {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  tokenHash         String          @unique @map("token_hash") @db.Char(64)
  familyId          String          @map("family_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedById      String?         @unique @map("replaced_by_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          RefreshSession? @relation("RefreshRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model GoogleChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  secretHash String   @unique @map("secret_hash") @db.Char(64)
  nonceHash  String   @map("nonce_hash") @db.Char(64)
  intent     String   @db.VarChar(10)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("google_challenges")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}
