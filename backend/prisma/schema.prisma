generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  name            String?
  // Nullable during migration so existing users do not need invented names.
  // Registration will require firstName and lastName; middleName is optional.
  firstName       String?          @map("first_name") @db.VarChar(60)
  middleName      String?          @map("middle_name") @db.VarChar(60)
  lastName        String?          @map("last_name") @db.VarChar(60)
  passwordHash    String?          @map("password_hash") @db.VarChar(60)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  tokenHash         String          @unique @map("token_hash") @db.Char(64)
  familyId          String          @map("family_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedById      String?         @unique @map("replaced_by_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          RefreshSession? @relation("RefreshRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
