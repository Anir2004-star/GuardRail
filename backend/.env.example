PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://guardrail_local:replace_with_local_password@localhost:5432/guardrail?schema=public
JWT_ACCESS_SECRET=replace_with_your_generated_64_character_hex_secret
JWT_ISSUER=guardrail-api
JWT_AUDIENCE=guardrail-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
# Google OAuth Web application client ID. No Google client secret is needed.
# GOOGLE_CLIENT_ID=1234567890-your-client-id.apps.googleusercontent.com
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=3600
# Development: local Mailpit inbox; no mail leaves this computer.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=guardrail@example.invalid
# Real SMTP: configure the provider host/port, a verified sender and both credentials.
# Production requires HTTPS frontend links and TLS/STARTTLS SMTP.
# SMTP_USER=
# SMTP_PASSWORD=
